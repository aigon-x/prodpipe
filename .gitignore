# ─────────────────────────────────────────────────────────────
# AIGON Production Platform — .gitignore
# Git przechowuje SOURCE / CONTRACTS / DECLARATIONS / SCHEMAS /
# DEPLOYMENT / POLICIES / TESTS. NIE przechowuje runtime state,
# secrets, build artifacts, cache, ani danych użytkowników.
# ─────────────────────────────────────────────────────────────

# ── Secrets — NIGDY nie commitować ────────────────────────────
*.env
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
secrets/**/*.secret
secrets/**/*.json
secrets/**/*.yaml
secrets/**/*.yml
!secrets/schemas/**
!secrets/templates/**

# ── Build artifacts ──────────────────────────────────────────
target/
build/
!tools/automation/build/
dist/
out/
*.o
*.a
*.so
*.dylib
*.exe
*.dll
*.class
*.jar
*.war
*.rlib
*.rmeta
*.wasm

# ── Rust ─────────────────────────────────────────────────────
Cargo.lock
**/Cargo.lock
!Cargo.lock
target/

# ── Node / JS ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.next/
.nuxt/
.vite/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── IDE / editor ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Artefakty robocze agenta (Qwen) — NIE wchodzą do repo ───
# .qwen/ zawiera worktrees, pamięć sesji i artefakty robocze.
# To nie jest część repo — moduły weryfikacji NIE powinny ich skanować.
.qwen/

# ── Runtime state / data — NIE wchodzi do git ────────────────
# Runtime state należy do Runtime, nie do repo.
data/**/*.db
data/**/*.sqlite
data/**/*.sqlite3
data/**/runtime-state/
data/**/node-local/
*.log
logs/
**/logs/

# ── TESTFORGE runtime results — NIE wchodzi do git ───────────
# Wyniki testów to runtime state (maszynowy output), nie source.
.testforge-results/

# ── Canonical state DB — NIE wchodzi do git ──────────────────
# SQLite = canonical operational state. Git trzyma tylko schema + migracje.
system/control-plane/state/data/*.db
system/control-plane/state/data/*.sqlite
system/control-plane/state/data/*.sqlite3
# Backupi canonical state (F5) — runtime artifacts, NIE wchodzą do git.
system/control-plane/state/data/backups/
system/control-plane/state/data/backups/*.db
system/control-plane/state/data/backups/*.sha256
system/control-plane/state/data/backups/*.json

# ── AIGON-X-FS runtime data — NIE wchodzi do git ─────────────
# AIGON-X-FS przechowuje runtime data (knowledge, memory, artifacts,
# evidence, user data). To NIE jest repo. Git trzyma tylko schematy.
filesystem/**/data/
filesystem/**/blocks/
filesystem/**/chunks/
filesystem/**/snapshots/
filesystem/**/shards/

# ── Artifacts — tylko manifesty/digesty w git, nie binaria ──
artifacts/builds/*
!artifacts/builds/.gitkeep
artifacts/releases/*
!artifacts/releases/.gitkeep
artifacts/certificates/*
!artifacts/certificates/.gitkeep
artifacts/reports/gates/*
!artifacts/reports/gates/.gitkeep

# ── Generated config — regenerowane z canonical ──────────────
config/generated/*
!config/generated/.gitkeep

# ── Governance generated ─────────────────────────────────────
governance/generated/*
!governance/generated/.gitkeep

# ── Docs generated ───────────────────────────────────────────
docs/generated/*
!docs/generated/.gitkeep
# OPERATION CONFIG ZERO — certyfikowane deliverable (tracked, nie generated)
!docs/generated/config-zero/
!docs/generated/config-zero/**

# ── Test artifacts ───────────────────────────────────────────
tests/**/output/
tests/**/artifacts/
tests/**/coverage/
coverage/
*.profraw
*.lcov

# ── Terraform / IaC state ────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/
crash.log

# ── Misc ─────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
.Trash-*
