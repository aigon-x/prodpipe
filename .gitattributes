# ─────────────────────────────────────────────────────────────
# AIGON Production Platform — .gitattributes
# Normalizacja linii, atrybuty diff/merge dla plików tekstowych
# i binarnych. Wymusza LF (nie CRLF) dla deterministycznych buildów.
# ─────────────────────────────────────────────────────────────

# Normalizacja końców linii — zawsze LF
* text=auto eol=lf

# Pliki tekstowe
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.proto text eol=lf
*.graphql text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
Taskfile.yml text eol=lf

# Skrypty — wymuś executable bit
*.sh text eol=lf
*.py text eol=lf

# Pliki binarne — nie diffuj
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.wasm binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary

# Lockfile — nie diffuj (regenerowany)
Cargo.lock -diff
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff

# Merge drivers — schematy JSON/YAML scalaj liniowo
*.json merge=union
*.yaml merge=union
*.yml merge=union
