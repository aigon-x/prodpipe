{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config/schemas/platform.schema.json",
  "title": "AIGON Platform Canonical Config Schema",
  "description": "JSON Schema walidacji canonical config (config/canonical/platform.yaml). STATUS: CANONICAL.",
  "type": "object",
  "required": ["schema_version", "config_id", "status", "platform"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "config_id": { "type": "string" },
    "status": { "type": "string", "enum": ["CANONICAL", "UNDEFINED", "FOUNDATION_PLACEHOLDER"] },
    "platform": {
      "type": "object",
      "required": ["name", "version", "repository", "baseline_tag"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "repository": { "type": "string" },
        "baseline_tag": { "type": "string" }
      }
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "stages": { "type": "array", "items": { "type": "string" } },
        "override_hierarchy": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": "object",
      "properties": {
        "categories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "database_id": { "type": "string" },
        "schema_version": { "type": "string" },
        "db_path": { "type": "string" },
        "backup_retention_default": { "type": "integer" },
        "tables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verify": {
      "type": "object",
      "properties": {
        "entrypoint": { "type": "string" },
        "subcommands": { "type": "array", "items": { "type": "string" } },
        "modules": { "type": "array", "items": { "type": "object" } },
        "orphaned_modules": { "type": "array", "items": { "type": "string" } },
        "ghost_modules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "rings": { "type": "array", "items": { "type": "object" } },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "canonical_branch": { "type": "string" },
        "allowed_branch_prefixes": { "type": "array", "items": { "type": "string" } },
        "allowed_tag_prefixes": { "type": "array", "items": { "type": "string" } },
        "merge_chain": { "type": "array", "items": { "type": "string" } }
      }
    },
    "readme_contract": {
      "type": "object",
      "properties": {
        "required_sections": { "type": "array", "items": { "type": "string" } },
        "optional_sections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ownership": {
      "type": "object",
      "properties": {
        "owners": { "type": "array", "items": { "type": "object" } },
        "boundaries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "classes": { "type": "array", "items": { "type": "string" } },
        "rule": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "policy": { "type": "string" },
        "storage": { "type": "string" },
        "references": { "type": "string" },
        "rotation": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
